{
	"name": "caresync-pipeline",
	"properties": {
		"activities": [
			{
				"name": "prostgecopy",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": "select * from public.hospitals",
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "hospital_id",
									"type": "Int32",
									"physicalType": "integer"
								},
								"sink": {
									"name": "hospital_id",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "hospital_name",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "hospital_name",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "city",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "city",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "state",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "state",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "hospital_type",
									"type": "String",
									"physicalType": "character varying"
								},
								"sink": {
									"name": "hospital_type",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "bed_count",
									"type": "Int32",
									"physicalType": "integer"
								},
								"sink": {
									"name": "bed_count",
									"type": "Int32",
									"physicalType": "INT_32"
								}
							},
							{
								"source": {
									"name": "created_at",
									"type": "DateTime",
									"physicalType": "timestamp without time zone"
								},
								"sink": {
									"name": "created_at",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							},
							{
								"source": {
									"name": "updated_at",
									"type": "DateTime",
									"physicalType": "timestamp without time zone"
								},
								"sink": {
									"name": "updated_at",
									"type": "DateTime",
									"physicalType": "INT_96"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_PostgreSql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sink_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"containers": "landing",
							"folder": "test"
						}
					}
				]
			}
		],
		"annotations": []
	}
}